{
  "name": "@red-cup-engineering/agent-session-work-admission-service",
  "version": "0.1.0",
  "type": "module",
  "description": "Derives an agent session's frictions from its own transcript and admits work -- structured work intents, agency-work allocations, checkout-health and duplication findings, and work discharges -- onto the work rail. Harness-neutral: the transcript, the cursor file, the allocating office and the incumbent actor are all parameters, read from the calling machine's own policy records.",
  "exports": {
    ".": "./src/session-frictions.mjs",
    "./session-frictions": "./src/session-frictions.mjs",
    "./work-allocation": "./src/work-allocation.mjs",
    "./read-allocation-identity": "./scripts/read-allocation-identity.mjs"
  },
  "bin": {
    "derive-set-of-session-frictions": "./scripts/derive-set-of-session-frictions.mjs",
    "admit-set-of-session-frictions": "./scripts/admit-set-of-session-frictions.mjs",
    "admit-set-of-friction-work-intents": "./scripts/admit-set-of-friction-work-intents.mjs",
    "admit-friction": "./scripts/admit-friction.mjs",
    "derive-set-of-admitted-frictions": "./scripts/derive-set-of-admitted-frictions.mjs",
    "admit-set-of-health-work-intents": "./scripts/admit-set-of-health-work-intents.mjs",
    "admit-set-of-duplication-work-intents": "./scripts/admit-set-of-duplication-work-intents.mjs",
    "admit-structured-work-intent": "./scripts/admit-structured-work-intent.mjs",
    "admit-work-discharge": "./scripts/admit-work-discharge.mjs",
    "discharge-set-of-ready-duties": "./scripts/discharge-set-of-ready-duties.mjs",
    "run-census": "./scripts/run-census.mjs"
  },
  "files": [
    "src",
    "scripts",
    "package.json"
  ],
  "dependencies": {
    "@red-cup-engineering/agent-work-computer-system-engineering-services-section": "0.17.0",
    "@red-cup-engineering/execute-javascript-node-command-service": "0.2.2",
    "@red-cup-engineering/file-services": "0.4.0",
    "@red-cup-engineering/filepath-services-section": "0.1.0",
    "@red-cup-engineering/javascript-file-main-guard-service": "0.1.3",
    "@red-cup-engineering/javascript-node-services-section": "0.3.0",
    "@red-cup-engineering/make-directory-service": "0.1.0",
    "@red-cup-engineering/metroplat": "0.8.0",
    "@red-cup-engineering/project-file-url-filepath-service": "0.1.0",
    "@red-cup-engineering/read-javascript-node-standard-input-text-service": "0.2.1",
    "@red-cup-engineering/resolve-filepath-service": "0.1.1",
    "@red-cup-engineering/semantic-record-journal-service": "0.5.0",
    "@red-cup-engineering/stat-path-service": "0.1.0"
  },
  "scripts": {
    "check": "node --check src/session-frictions.mjs && node --check src/work-allocation.mjs && for f in scripts/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
