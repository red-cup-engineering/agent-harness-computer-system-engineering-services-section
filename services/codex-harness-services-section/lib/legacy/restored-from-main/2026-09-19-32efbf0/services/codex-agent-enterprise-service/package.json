    "./agential-forms": "./src/agential-forms.mjs",
    "./requirement-trajectory": "./src/requirement-trajectory.mjs",
    "./source-pinned-analysis": "./src/source-pinned-analysis.mjs",
    "./authority-bounded-integration": "./src/authority-bounded-integration.mjs",
    "./fresh-verification": "./src/fresh-verification.mjs",
    "./prompt-cycle": "./src/prompt-cycle.mjs",
    "./historical-demands": "./src/historical-demands.mjs",
    "./relevant-history": "./src/relevant-history.mjs",
    "./context-address": "./src/context-address.mjs",
    "./locus-registry": "./src/locus-registry.mjs",
    "./notebook-research-jobs": "./src/notebook-research-jobs.mjs",
