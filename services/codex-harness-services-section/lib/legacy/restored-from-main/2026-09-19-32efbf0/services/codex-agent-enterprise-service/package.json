    "./a2a-executor": "./src/a2a-executor.mjs",
    "./mcp-server": "./apps/mcp-server.mjs"
  },
  "bin": {
    "serve-codex-enterprise-mcp": "apps/mcp-server.mjs",
    "serve-codex-mape-office-mcp": "src/mape-office-mcp.mjs",
    "project-codex-enterprise-position": "scripts/project-enterprise-position.mjs",
    "execute-codex-enterprise-a2a-message": "scripts/execute-a2a-message.mjs",
    "observe-codex-native-usage": "scripts/observe-native-usage.mjs",
    "project-codex-mape-cycle": "scripts/project-codex-mape-cycle.mjs",
    "admit-next-codex-historical-demand": "scripts/admit-next-historical-demand.mjs",
    "run-codex-notebook-research-job": "scripts/run-notebook-research-job.mjs",
    "serve-codex-enterprise-activitypub": "scripts/serve-activitypub.mjs",
    "assay-codex-harness-candidate": "scripts/assay-harness-candidate.mjs",
    "assay-codex-harness-efficiency": "scripts/assay-codex-harness-efficiency.mjs"
  },
  "files": [
    "apps",
    "src",
    "scripts"
  ],
  "scripts": {
    "check": "node --check src/enterprise.mjs && node --check src/configuration.mjs && node --check src/semiotic-circuit.mjs && node --check apps/mcp-server.mjs && node --check src/mape-office-mcp.mjs",
    "test": "CODEX_ENTERPRISE_CONFIGURATION=test/fixtures/enterprise.json node --test --test-concurrency=1 test/*.test.mjs"
  },
