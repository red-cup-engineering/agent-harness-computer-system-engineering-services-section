    {
      "type": "array",
      "prefixItems": [
        { "oneOf": [ { "$ref": "https://561.group/claude-code-harness/library/token/token.schema.json" }, { "$ref": "https://561.group/claude-code-harness/library/void/void.schema.json" } ] },
        { "oneOf": [ { "$ref": "https://561.group/claude-code-harness/library/claim/claim.schema.json" }, { "$ref": "https://561.group/claude-code-harness/library/void/void.schema.json" } ] }
